{
  "name": "metabolic-risk-pdf-module",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/metabolic-risk-pdf.js",
  "module": "./dist/metabolic-risk-pdf.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/metabolic-risk-pdf.js"
    }
  },
  "files": [
    "dist",
    "src",
    "examples",
    "README.md",
    "整合檢查表.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2020 --outfile=dist/metabolic-risk-pdf.js",
    "check": "tsc -p tsconfig.json --noEmit false"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "typescript": "^5.9.0"
  }
}
